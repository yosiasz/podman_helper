              "type": "mssql",
              "uid": "mssql-working"
            },
            "rawSql": "SELECT \n  status,\n  COUNT(*) as count\nFROM (\n  SELECT 'High Risk' as status\n  UNION ALL SELECT 'High Risk'\n  UNION ALL SELECT 'High Risk'\n  UNION ALL SELECT 'High Risk'\n  UNION ALL SELECT 'Medium Risk'\n  UNION ALL SELECT 'Medium Risk'\n  UNION ALL SELECT 'Low Risk'\n  UNION ALL SELECT 'Low Risk'\n  UNION ALL SELECT 'Medium Risk'\n  UNION ALL SELECT 'Low Risk'\n  UNION ALL SELECT 'High Risk'\n  UNION ALL SELECT 'High Risk'\n  UNION ALL SELECT 'Low Risk'\n  UNION ALL SELECT 'High Risk'\n  UNION ALL SELECT 'Low Risk'\n  UNION ALL SELECT 'Medium Risk'\n) as risk_data\nGROUP BY status\nORDER BY count DESC",
