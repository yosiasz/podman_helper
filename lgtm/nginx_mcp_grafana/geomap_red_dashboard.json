              "uid": "mssql-working"
            },
            "rawSql": "SELECT \n  name as country,\n  value as risk_score,\n  status\nFROM (\n  SELECT 'United States' as name, 100 as value, 'High Risk' as status\n  UNION ALL SELECT 'Canada', 85, 'Medium Risk'\n  UNION ALL SELECT 'Mexico', 95, 'High Risk'\n  UNION ALL SELECT 'Brazil', 90, 'High Risk'\n  UNION ALL SELECT 'Argentina', 75, 'Medium Risk'\n  UNION ALL SELECT 'United Kingdom', 80, 'Medium Risk'\n  UNION ALL SELECT 'France', 70, 'Low Risk'\n  UNION ALL SELECT 'Germany', 65, 'Low Risk'\n  UNION ALL SELECT 'Italy', 75, 'Medium Risk'\n  UNION ALL SELECT 'Spain', 60, 'Low Risk'\n  UNION ALL SELECT 'Russia', 95, 'High Risk'\n  UNION ALL SELECT 'China', 88, 'High Risk'\n  UNION ALL SELECT 'Japan', 55, 'Low Risk'\n  UNION ALL SELECT 'India', 85, 'High Risk'\n  UNION ALL SELECT 'Australia', 45, 'Low Risk'\n  UNION ALL SELECT 'South Africa', 80, 'Medium Risk'\n) as risk_data\nORDER BY value DESC",
            "format": "table"
          }
        ],
